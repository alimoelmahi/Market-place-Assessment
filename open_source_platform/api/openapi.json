      "Weights": {"type": "object", "required": ["P", "A", "F", "C", "E", "R"], "additionalProperties": false, "description": "Server enforces sum equals 1 within 1e-6; official weights are not mutated.", "properties": {"P": {"type": "number", "minimum": 0, "maximum": 1}, "A": {"type": "number", "minimum": 0, "maximum": 1}, "F": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "minimum": 0, "maximum": 1}, "E": {"type": "number", "minimum": 0, "maximum": 1}, "R": {"type": "number", "minimum": 0, "maximum": 1}}},
      "ExperimentRequest": {"type": "object", "required": ["release_id", "scenario_id", "market_ids", "weights", "scope"], "additionalProperties": false, "properties": {"release_id": {"type": "string", "format": "uuid"}, "scenario_id": {"type": "string", "format": "uuid"}, "market_ids": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "maxLength": 40}}, "weights": {"$ref": "#/components/schemas/Weights"}, "scope": {"type": "string", "enum": ["exploratory"]}}},
