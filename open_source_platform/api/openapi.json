{
  "openapi": "3.0.3",
  "info": {"title": "Khartoum Markets Intelligence API", "version": "1.0.0-design", "description": "Implementation contract only. Released secondary evidence; no invented market observations. Protected actions additionally require server-side roles and object authorization."},
  "servers": [{"url": "/"}],
  "security": [{"sessionCookie": []}, {}],
  "paths": {
    "/auth/login": {"get": {"operationId": "startLogin", "security": [], "parameters": [{"name": "return_to", "in": "query", "schema": {"type": "string", "maxLength": 1000}, "description": "Allowlisted local application path only; no open redirect."}], "responses": {"302": {"description": "Redirect to approved OIDC provider with state nonce and PKCE"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/auth/callback": {"get": {"operationId": "oidcCallback", "security": [], "parameters": [{"name": "code", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 4096}}, {"name": "state", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 1024}}], "responses": {"302": {"description": "Verified exchange; secure session cookie; allowlisted return location. Never log code or tokens."}, "401": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/auth/logout": {"post": {"operationId": "logout", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/Csrf"}], "responses": {"204": {"description": "Session invalidated and cookie cleared"}, "401": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/session": {"get": {"operationId": "sessionContext", "responses": {"200": {"description": "Same-origin UI session capabilities and CSRF value; never bearer/refresh tokens or private identity profile; private no-store", "content": {"application/json": {"schema": {"type": "object", "required": ["authenticated", "roles"], "properties": {"authenticated": {"type": "boolean"}, "csrf_token": {"type": "string", "nullable": true, "description": "Present for authenticated mutations according to the tested CSRF/session scheme"}, "roles": {"type": "array", "items": {"type": "string", "enum": ["reader", "analyst", "reviewer", "publisher"]}}}}}}}}}},
    "/health/live": {"get": {"operationId": "liveness", "security": [], "responses": {"200": {"description": "Process alive"}}}},
    "/health/ready": {"get": {"operationId": "readiness", "security": [], "responses": {"200": {"description": "Dependencies and approved application state ready"}, "503": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases": {"get": {"operationId": "listReleases", "responses": {"200": {"description": "Authorized release metadata only", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Release"}}}}}}}},
    "/v1/releases/current": {"get": {"operationId": "currentRelease", "responses": {"200": {"description": "Current release according to server audience policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Release"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "getRelease", "responses": {"200": {"description": "Authorized release", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Release"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/markets": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "listMarkets", "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 120}}, {"name": "locality", "in": "query", "schema": {"type": "string", "maxLength": 80}}, {"name": "market_type", "in": "query", "schema": {"type": "string", "maxLength": 40}}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["documented_open", "documented_partial", "documented_closed", "historical_only", "unknown"]}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 1000}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}], "responses": {"200": {"description": "Stable released directory; unresolved geometry remains null", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MarketPage"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/markets/{market_id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"$ref": "#/components/parameters/MarketId"}], "get": {"operationId": "marketProfile", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Profile within one coherent released context", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MarketProfile"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/markets/{market_id}/observations": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"$ref": "#/components/parameters/MarketId"}], "get": {"operationId": "marketObservations", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Sanitized released observations only", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Observation"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/scenarios": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "releaseScenarios", "responses": {"200": {"description": "Approved scenarios compatible with this release", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Scenario"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/layers": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "releaseLayers", "responses": {"200": {"description": "Curated authorized layer descriptors", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Layer"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/tiles/{layer_id}/{z}/{x}/{y}.mvt": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "layer_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"}}, {"name": "z", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0, "maximum": 22}}, {"name": "x", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0}}, {"name": "y", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0}}], "get": {"operationId": "vectorTile", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Curated vector tile; coordinate bounds also checked against zoom", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/vnd.mapbox-vector-tile": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/scores": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "officialScores", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Official released comparison; no weight override allowed", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Score"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/analytics/{product_id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "product_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^V(0[1-9]|10)$"}}], "get": {"operationId": "visualisationData", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Reviewed tabular or flow dataset according to product contract; private source rows excluded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VisualisationData"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/recommendations": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "recommendations", "responses": {"200": {"description": "Conditional approved-for-disclosure option records", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Option"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/sources": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "releaseSources", "responses": {"200": {"description": "Publication-safe source metadata without restricted file locations", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Source"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/indicators": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "get": {"operationId": "releaseIndicators", "responses": {"200": {"description": "Approved-for-disclosure indicator dictionary, not raw confidential instrument text", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/IndicatorDefinition"}}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/experiments": {"post": {"operationId": "createExperiment", "security": [{"sessionCookie": []}], "x-required-roles": ["analyst"], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExperimentRequest"}}}}, "responses": {"202": {"description": "Private exploratory job queued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}, "429": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/experiments/{experiment_id}/sensitivity": {"parameters": [{"name": "experiment_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "post": {"operationId": "experimentSensitivity", "security": [{"sessionCookie": []}], "x-required-roles": ["analyst"], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SensitivityRequest"}}}}, "responses": {"202": {"description": "Owner-scoped sensitivity job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/jobs/{job_id}": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "get": {"operationId": "getJob", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Authorized owner/admin status only", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "404": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/jobs/{job_id}/result": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "get": {"operationId": "jobResult", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Owner-scoped result; type discriminator matches completed job kind", "content": {"application/json": {"schema": {"oneOf": [{"$ref": "#/components/schemas/ExperimentResult"}, {"$ref": "#/components/schemas/SensitivityResult"}, {"$ref": "#/components/schemas/ExportResult"}], "discriminator": {"propertyName": "result_type", "mapping": {"experiment": "#/components/schemas/ExperimentResult", "sensitivity": "#/components/schemas/SensitivityResult", "export": "#/components/schemas/ExportResult"}}}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/jobs/{job_id}/download": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "get": {"operationId": "downloadExport", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Owner-scoped completed export; release/rights rechecked; private no-store response", "content": {"text/csv": {"schema": {"type": "string", "format": "binary"}}, "application/geo+json": {"schema": {"$ref": "#/components/schemas/FeatureCollection"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/layers/{layer_id}/features": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"$ref": "#/components/parameters/LayerId"}], "get": {"operationId": "layerFeatures", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}, {"name": "bbox", "in": "query", "schema": {"type": "string", "maxLength": 100}, "description": "west,south,east,north; server checks coordinate order/ranges and maximum query extent"}], "responses": {"200": {"description": "Bounded cleared features; never silently truncated", "content": {"application/geo+json": {"schema": {"$ref": "#/components/schemas/FeatureCollection"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "413": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/rasters/{layer_id}/{z}/{x}/{y}.png": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"$ref": "#/components/parameters/LayerId"}, {"$ref": "#/components/parameters/TileZ"}, {"$ref": "#/components/parameters/TileX"}, {"$ref": "#/components/parameters/TileY"}], "get": {"operationId": "rasterTile", "parameters": [{"$ref": "#/components/parameters/ScenarioQuery"}], "responses": {"200": {"description": "Approved COG derivative tile with registered rendering; no arbitrary remote URL", "content": {"image/png": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/releases/{release_id}/assets/{asset_id}": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}, {"name": "asset_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"operationId": "approvedAsset", "parameters": [{"name": "Range", "in": "header", "schema": {"type": "string", "maxLength": 100}}], "responses": {"200": {"description": "Approved release asset; actual rights and audience checked", "headers": {"Accept-Ranges": {"schema": {"type": "string"}}, "ETag": {"schema": {"type": "string"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "206": {"description": "Authorized byte range for PMTiles/COG where supported", "headers": {"Content-Range": {"schema": {"type": "string"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "404": {"$ref": "#/components/responses/ErrorResponse"}, "416": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/exports": {"post": {"operationId": "createExport", "security": [{"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExportRequest"}}}}, "responses": {"202": {"description": "Permitted scoped export queued; download metadata returned through job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}, "422": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/review/releases/{release_id}/decision": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "post": {"operationId": "reviewRelease", "security": [{"sessionCookie": []}], "x-required-roles": ["reviewer"], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewDecision"}}}}, "responses": {"200": {"description": "Decision recorded; not an automatic publish", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Release"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/review/releases/{release_id}/publish": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "post": {"operationId": "publishRelease", "security": [{"sessionCookie": []}], "x-required-roles": ["publisher"], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "responses": {"200": {"description": "Publish only after independent approvals, model and assets readiness", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Release"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}, "409": {"$ref": "#/components/responses/ErrorResponse"}}}},
    "/v1/review/releases/{release_id}/withdraw": {"parameters": [{"$ref": "#/components/parameters/ReleaseId"}], "post": {"operationId": "withdrawRelease", "security": [{"sessionCookie": []}], "x-required-roles": ["publisher"], "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 2000}}}}}}, "responses": {"200": {"description": "Withdrawn and mutable cache references invalidated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Release"}}}}, "401": {"$ref": "#/components/responses/ErrorResponse"}, "403": {"$ref": "#/components/responses/ErrorResponse"}}}}
  },
  "components": {
    "securitySchemes": {"sessionCookie": {"type": "apiKey", "in": "cookie", "name": "khm_session", "description": "Institutionally approved OIDC/BFF session; RBAC and object scope enforced separately."}},
    "parameters": {
      "ReleaseId": {"name": "release_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "MarketId": {"name": "market_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"}},
      "JobId": {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "LayerId": {"name": "layer_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"}},
      "TileZ": {"name": "z", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0, "maximum": 22}},
      "TileX": {"name": "x", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0}},
      "TileY": {"name": "y", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0}},
      "ScenarioQuery": {"name": "scenario_id", "in": "query", "description": "Omitted means the release default; any supplied value must match the release model and allowed set.", "schema": {"type": "string", "format": "uuid"}},
      "Csrf": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 512}},
      "Idempotency": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}
    },
    "responses": {"ErrorResponse": {"description": "Safe domain error; no sensitive object existence or credentials disclosed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Error": {"type": "object", "required": ["code", "message", "request_id"], "additionalProperties": false, "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}},
      "Release": {"type": "object", "required": ["release_id", "version", "state", "audience", "model_version", "default_scenario_id", "marketset_id", "period_id"], "properties": {"release_id": {"type": "string", "format": "uuid"}, "version": {"type": "string"}, "state": {"type": "string", "enum": ["draft", "review", "approved", "published", "withdrawn", "retired"]}, "audience": {"type": "string", "enum": ["public", "internal"]}, "model_version": {"type": "string"}, "marketset_id": {"type": "string"}, "period_id": {"type": "string"}, "default_scenario_id": {"type": "string", "format": "uuid"}, "observed_start": {"type": "string", "format": "date", "nullable": true}, "observed_end": {"type": "string", "format": "date", "nullable": true}, "published_at": {"type": "string", "format": "date-time", "nullable": true}}},
      "PointGeometry": {"type": "object", "nullable": true, "required": ["type", "coordinates"], "additionalProperties": false, "properties": {"type": {"type": "string", "enum": ["Point"]}, "coordinates": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}},
      "Market": {"type": "object", "required": ["market_id", "name_ar", "name_en", "geometry_status", "geometry"], "properties": {"market_id": {"type": "string"}, "name_ar": {"type": "string"}, "name_en": {"type": "string"}, "locality": {"type": "string", "nullable": true}, "administrative_unit": {"type": "string", "nullable": true}, "market_type": {"type": "string", "nullable": true}, "geometry_status": {"type": "string", "enum": ["verified", "approximate", "disputed", "unverified"]}, "geometry": {"$ref": "#/components/schemas/PointGeometry"}, "operating_status": {"type": "string", "enum": ["documented_open", "documented_partial", "documented_closed", "historical_only", "unknown"]}}},
      "MarketPage": {"type": "object", "required": ["release_id", "items", "next_cursor"], "properties": {"release_id": {"type": "string", "format": "uuid"}, "items": {"type": "array", "items": {"$ref": "#/components/schemas/Market"}}, "next_cursor": {"type": "string", "nullable": true}}},
      "Observation": {"type": "object", "required": ["indicator_id", "unit", "evidence_type", "eligible", "source_refs", "reliability_score"], "properties": {"indicator_id": {"type": "string", "pattern": "^I[0-9]{2}$"}, "value_num": {"type": "number", "nullable": true}, "value_text": {"type": "string", "nullable": true}, "unit": {"type": "string"}, "denominator": {"type": "number", "minimum": 0, "nullable": true}, "observed_start": {"type": "string", "format": "date", "nullable": true}, "observed_end": {"type": "string", "format": "date", "nullable": true}, "spatial_support": {"type": "string"}, "evidence_type": {"type": "string", "enum": ["D", "R", "M", "A", "U"]}, "reliability_score": {"type": "number", "minimum": 0, "maximum": 100, "nullable": true}, "confidence_class": {"type": "string", "enum": ["high", "medium", "low", "unknown"]}, "eligible": {"type": "boolean"}, "missing_reason": {"type": "string", "nullable": true}, "lower_bound": {"type": "number", "nullable": true}, "upper_bound": {"type": "number", "nullable": true}, "bound_type": {"type": "string", "nullable": true}, "source_refs": {"type": "array", "items": {"type": "string"}}}},
      "Gate": {"type": "object", "required": ["gate_type", "status", "required_action"], "properties": {"gate_type": {"type": "string"}, "status": {"type": "string", "enum": ["pass", "fail", "unknown"]}, "required_action": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time", "nullable": true}}},
      "Score": {"type": "object", "required": ["release_id", "market_id", "scenario_id", "model_version", "score_lower", "score_upper", "point_score", "covered_weight", "coverage_class", "analytical_rank", "investment_rank"], "properties": {"release_id": {"type": "string", "format": "uuid"}, "market_id": {"type": "string"}, "scenario_id": {"type": "string", "format": "uuid"}, "model_version": {"type": "string"}, "score_lower": {"type": "number", "minimum": 0, "maximum": 100}, "score_upper": {"type": "number", "minimum": 0, "maximum": 100}, "point_score": {"type": "number", "minimum": 0, "maximum": 100, "nullable": true}, "covered_weight": {"type": "number", "minimum": 0, "maximum": 1}, "coverage_class": {"type": "string", "enum": ["complete", "provisional", "insufficient"]}, "analytical_rank": {"type": "integer", "minimum": 1, "nullable": true}, "investment_rank": {"type": "integer", "minimum": 1, "nullable": true}, "need_class": {"type": "string"}, "gate_status": {"type": "string", "enum": ["pass", "fail", "unknown"]}, "components": {"type": "array", "items": {"type": "object", "required": ["id", "weight", "score"], "properties": {"id": {"type": "string"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}, "score": {"type": "number", "minimum": 0, "maximum": 100, "nullable": true}, "lower": {"type": "number"}, "upper": {"type": "number"}}}}}},
